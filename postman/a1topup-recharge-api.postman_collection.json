{
  "info": {
    "name": "A1Topup Recharge API",
    "description": "Docs: https://a1topup.com/api/recharge-api-integration \u00b7 GitHub: https://github.com/A1topup/a1topup-recharge-api \u00b7 Support: WhatsApp +91 91610 19161. Your server IP must be whitelisted. Never share real credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/authentication?username={{username}}&pwd={{password}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "authentication"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "pwd",
              "value": "{{password}}"
            }
          ]
        },
        "description": "Check your API username and password."
      },
      "response": []
    },
    {
      "name": "Recharge (mobile / DTH / postpaid / bills)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api?username={{username}}&pwd={{password}}&circlecode={{circlecode}}&operatorcode={{operatorcode}}&number={{number}}&amount={{amount}}&orderid={{orderid}}&value1=&format=json",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api"
          ],
          "query": [
            {
              "key": "username",
              "value": "{{username}}"
            },
            {
              "key": "pwd",
              "value": "{{password}}"
            },
            {
              "key": "circlecode",
              "value": "{{circlecode}}"
            },
            {
              "key": "operatorcode",
              "value": "{{operatorcode}}"
            },
            {
              "key": "number",
              "value": "{{number}}"
            },
            {
              "key": "amount",
              "value": "{{amount}}"
            },
            {
              "key": "orderid",
              "value": "{{orderid}}"
            },
            {
              "key": "value1",
              "value": ""
            },
            {
              "key": "format",
              "value": "json"
            }
          ]
        },
        "description": "Use a new orderid for every recharge. Minimum amount 10. value1 only for billers that need it. Response txid = A1Topup transaction id, orderid = your id."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "try { const j = pm.response.json(); pm.test('Has status', () => pm.expect(j).to.have.property('status')); } catch (e) {}"
            ]
          }
        }
      ]
    },
